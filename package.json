{
  "name": "@local/dsh-sidebar-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Manage the left sidebar entries of the DSH Web GUI: hide the rows you do not use, keep the choice in the profile, and restore them from the More menu.",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
